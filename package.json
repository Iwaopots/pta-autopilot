{
  "name": "dsh-pta",
  "version": "0.5.0",
  "description": "DSH 适配版 · PTA（pintia.cn）作业工具包：面板一键派发直达模型、多账号并发调度、凭据隔离、原生 Skill。",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "vendor",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pta",
    "pintia",
    "homework"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node scripts/gate.mjs --offline --syntax-only",
    "test": "node test/smoke.mjs && node test/scheduler.mjs && node test/client-contract.mjs && node test/panel-render.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:offline": "node scripts/gate.mjs --offline",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
